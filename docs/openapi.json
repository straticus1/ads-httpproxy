    "/api/analysis/findings": {
      "get": {
        "summary": "List fresh sampled findings (global administrator access)",
        "tags": [
          "Platform"
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Authentication required"
          },
          "404": {
            "description": "Feature not enabled"
          },
          "503": {
            "description": "API authentication not configured"
          },
          "403": {
            "description": "Credential scope or tenant mismatch"
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "tenant",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "category",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 100
            }
          }
        ],
        "description": "Global administrators may select any tenant. Scoped API credentials are bound to their configured tenant; omitted tenant selects that tenant and conflicting tenant returns 403."
      }
    },
