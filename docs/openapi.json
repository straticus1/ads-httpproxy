    "/api/adaptive/policy": {
      "get": {
        "summary": "Read current adaptive policy and retained history",
        "tags": [
          "Platform"
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Authentication required"
          },
          "404": {
            "description": "Feature not enabled"
          },
          "503": {
            "description": "API authentication not configured"
          }
        }
      },
      "put": {
        "summary": "Atomically replace adaptive policy",
        "tags": [
          "Platform"
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Authentication required"
          },
          "404": {
            "description": "Feature not enabled"
          },
          "503": {
            "description": "API authentication not configured"
          },
          "409": {
            "description": "Version conflict or persistence failure; policy unchanged"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "expected_version": {
                    "type": "integer"
                  },
                  "mode": {
                    "type": "string",
                    "enum": [
                      "observe",
                      "shadow",
                      "enforce"
                    ]
                  },
                  "rules": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "id",
                        "action"
                      ],
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "tenant": {
                          "type": "string"
                        },
                        "host": {
                          "type": "string"
                        },
                        "path_prefix": {
                          "type": "string"
                        },
                        "category": {
                          "type": "string"
                        },
                        "action": {
                          "type": "string",
                          "enum": [
                            "allow",
                            "block"
                          ]
                        },
                        "min_confidence": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        },
                        "expires_at": {
                          "type": "string",
                          "format": "date-time"
                        }
                      }
                    }
                  }
                },
                "additionalProperties": false,
                "required": [
                  "expected_version",
                  "mode",
                  "rules"
                ]
              }
            }
          }
        }
      }
    },
    "/api/adaptive/preview": {
