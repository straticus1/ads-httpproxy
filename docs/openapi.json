{
  "openapi": "3.0.3",
  "info": {
    "title": "ADS HTTP Proxy Management API",
    "version": "1.0.0",
    "description": "API keys and configured Basic users are alternatives. Public health/metrics/PAC/dashboard routes are unauthenticated. Optional cache and developer routes return 404 when not mounted. Error bodies are plain text. Configuration mutation is disabled. Platform endpoints require configured administrator authentication and are mounted only when their feature is enabled. See enterprise-platform.md for operational limits. Signed-policy delivery requires global administration plus a trusted signature. Scoped API keys permit only their tenant findings/explanations. With scoped keys configured, metrics require global administration and public PAC rejects tenant/user selectors."
  },
  "servers": [
    {
      "url": "http://localhost:9090"
    }
  ],
  "security": [
    {
      "apiKey": []
    },
    {
      "basicAuth": []
    }
  ],
